    given-names: Shaho
    affiliation: "Salahaddin University, Erbil"
repository-code: "https://github.com/shahoismael/compressed-ai-tutors"
license: MIT
keywords:
  - large language models
  - quantisation
  - Green AI
  - automated assessment
  - semantic entropy
